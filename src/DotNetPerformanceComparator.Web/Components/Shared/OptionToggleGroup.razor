@* Grupo de opciones de selección múltiple (botones conmutables). El estado se comunica con
   aria-pressed y texto, no solo con color. *@
<div class="option-toggle-group" role="group" aria-label="@Label">
    @foreach (var opcion in Options)
    {
        var seleccionado = Selected.Contains(opcion.Id);
        <button type="button"
                class="option-toggle @(seleccionado ? "option-toggle--on" : null)"
                aria-pressed="@(seleccionado ? "true" : "false")"
                disabled="@Disabled"
                @onclick="() => Alternar(opcion.Id)">
            <span class="option-toggle__check" aria-hidden="true">@(seleccionado ? "✓" : "")</span>
            <span>@opcion.Nombre</span>
        </button>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public IReadOnlyList<ToggleOption> Options { get; set; } = [];

    [Parameter, EditorRequired]
    public ISet<int> Selected { get; set; } = new HashSet<int>();

    [Parameter]
    public EventCallback<int> OnToggle { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    private Task Alternar(int id) => OnToggle.InvokeAsync(id);

    public sealed record ToggleOption(int Id, string Nombre);
}
