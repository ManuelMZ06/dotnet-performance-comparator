@page "/"
@using DotNetPerformanceComparator.Application.Evaluations.Results
@using DotNetPerformanceComparator.Application.Evaluations.Comparison
@using DotNetPerformanceComparator.Web.Components.Shared.Charts
@inject IConsultaResultadosService Consulta
@inject IComparacionResultadosService Comparador
@inject ILogger<Home> Logger

@* M-01 Inicio / Panel principal. "Resumen comparativo reciente" conectado a CU-07/CU-08 (C-11.3).
   Las tarjetas de resumen y "Actividad reciente" siguen en estado vacío (B-04, B-05, B-06; docs/UI_SPEC.md). *@

<PageHeader Title="Inicio / Panel principal"
            Description="Vista general del sistema y acceso rápido a las funciones principales" />

<div class="summary-grid">
    <SummaryCard Label="Proyecto activo" Value="Sin proyecto registrado" />
    <SummaryCard Label="Última migración" Value="Sin migraciones" />
    <SummaryCard Label="Última evaluación" Value="Sin evaluaciones" />
    <SummaryCard Label="Último reporte" Value="No disponible" />
</div>

<div class="home-grid">
    <Panel Title="Accesos rápidos">
        <div class="quick-access-grid">
            <QuickAccessCard Title="Incorporar proyecto" Subtitle=".NET 8" Href="incorporar-proyecto" />
            <QuickAccessCard Title="Migrar a .NET 10" Subtitle="Preparar versión experimental" Href="migracion" />
            <QuickAccessCard Title="Configurar evaluación" Subtitle="Pruebas, métricas y repeticiones" Href="configuracion" />
            <QuickAccessCard Title="Consultar resultados" Subtitle="Historial y filtros" />
        </div>
    </Panel>

    <Panel Title="Resumen comparativo reciente">
        @if (_resumen.Cargando)
        {
            <p class="home-resumen__cargando">Cargando resumen…</p>
        }
        else if (_resumen.Error)
        {
            <EmptyState Message="No fue posible preparar el resumen comparativo reciente." />
        }
        else if (_resumen.HayResumen && _resumen.Evaluacion is { } ev)
        {
            <p class="home-resumen__contexto">
                <strong>@ev.Nombre</strong> · @ev.Proyecto · @ev.TipoPrueba · @ConsultaResultadosModelo.FechaCorta(ev.FechaCreacion)
                <span class="home-resumen__versiones">.NET 8 (base) vs .NET 10 (experimental)</span>
            </p>
            <div class="home-resumen__grid">
                @foreach (var grupo in _resumen.Graficos)
                {
                    <div class="home-resumen__card">
                        <h4 class="home-resumen__card-titulo">@grupo.Category <span class="home-resumen__unidad">(@grupo.Unit)</span></h4>
                        <BarChart Groups="@(new[] { grupo })" Title="@($"{grupo.Category} — .NET 8 vs .NET 10")" />
                    </div>
                }
            </div>
            <a class="btn btn-secondary btn-sm home-resumen__accion" href="@($"/comparacion/{ev.Id}")">Ver comparación</a>
        }
        else
        {
            <EmptyState Message="Aún no hay resultados comparables para visualizar." />
        }
    </Panel>
</div>

<Panel Title="Actividad reciente">
    <EmptyState Message="Todavía no hay actividad disponible." />
</Panel>

<div class="page-actions">
    @* Destino M-04 aún no implementado. *@
    <button type="button" class="btn btn-primary" disabled>Crear nueva evaluación</button>
</div>

@code {
    private InicioResumenModelo _resumen = default!;

    protected override async Task OnInitializedAsync()
    {
        _resumen = new InicioResumenModelo(Consulta, Comparador, Logger);
        await _resumen.CargarAsync();
    }
}
