@page "/ejecucion/{ConfiguracionId:int}"
@using System.Globalization
@using DotNetPerformanceComparator.Application.Evaluations.Execution
@using DotNetPerformanceComparator.Web.Components.Shared.Charts
@using DotNetPerformanceComparator.Web.Execution
@implements IDisposable
@inject IEjecutarEvaluacionService Servicio
@inject IExecutionStatusQueryService StatusQuery
@inject IEvaluationExecutionSessionManager Manager
@inject ILogger<Ejecucion> Logger

@* M-05 — CU-04 Ejecutar prueba de rendimiento (Carga / Estrés / Concurrencia). Ejecución server-side (C-07.5). *@

<PageHeader Title="Ejecución de evaluación"
            Description="Monitoreo de la prueba en curso y de las métricas recolectadas" />

<OperationMessage Kind="_mensajeTipo" Message="@_mensaje" />

@if (_info is { } info)
{
    <div class="ejecucion-grid">
        <div class="ejecucion-grid__estado">
            <Panel Title="Estado general">
                <KeyValueList Items="Cabecera(info)" />

                <div class="ejecucion-estado">
                    <span class="ejecucion-estado__badge ejecucion-estado__badge--@(EstadoConfig?.ToLowerInvariant())">
                        @EstadoTexto(EstadoConfig)
                    </span>
                    @if (_snapshot is { Activa: true } s)
                    {
                        <span class="ejecucion-estado__fase">
                            @FaseTexto(s.Fase)
                            @if (s.VersionActual is not null)
                            {
                                <text> · @s.VersionActual · repetición @s.NumeroEjecucionActual</text>
                            }
                            @if (s.Fase == FaseEjecucion.NivelEstres && s.NivelActual is { } n)
                            {
                                <text> · Nivel @n@(s.TotalNiveles is { } t ? $" de {t}" : "") · @s.UsuariosNivel usuarios concurrentes</text>
                            }
                            @if (s.Fase == FaseEjecucion.Concurrencia && s.UsuariosConcurrentes is { } uc)
                            {
                                <text>@(s.RondaActual is { } ronda ? $" · Ronda {ronda}" : "")@(s.TotalRondas is { } tr ? $" de {tr}" : "") · @uc usuarios concurrentes</text>
                            }
                        </span>
                    }
                </div>

                @if (_snapshot is { TotalPasos: > 0 } sp)
                {
                    <div class="ejecucion-progreso" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@sp.ProgresoPorcentaje">
                        <div class="ejecucion-progreso__barra" style="width:@sp.ProgresoPorcentaje.ToString(CultureInfo.InvariantCulture)%"></div>
                        <span class="ejecucion-progreso__texto">@sp.OrdenGlobal / @sp.TotalPasos</span>
                    </div>
                }

                @if (_snapshot is { Activa: true } sv && (sv.CpuActual is not null || sv.RamActual is not null))
                {
                    <div class="ejecucion-vivos">
                        <span>CPU: @Num(sv.CpuActual) %</span>
                        <span>RAM: @Num(sv.RamActual) MB</span>
                    </div>
                }

                <div class="ejecucion-acciones">
                    @if (PuedeIniciar)
                    {
                        <button type="button" class="btn btn-success" @onclick="IniciarAsync">Iniciar evaluación</button>
                    }
                    @if (_snapshot is { PuedeCancelar: true })
                    {
                        <button type="button" class="btn btn-danger" @onclick="DetenerAsync">Detener evaluación</button>
                    }
                    else if (_snapshot is { EstadoSesion: EstadoSesion.Cancelando })
                    {
                        <button type="button" class="btn btn-danger" disabled>Cancelando...</button>
                    }
                </div>
            </Panel>

            @if (_snapshot is not null && (_snapshot.Activa || _snapshot.SerieCpu.Count > 0))
            {
                <Panel Title="Evolución de consumo de CPU">
                    <LineChart Points="_snapshot.SerieCpu" />
                </Panel>
            }

            @{ var resultados = Resultados; }
            @if (resultados.Count > 0)
            {
                <Panel Title="Resultados por ejecución">
                    <table class="resultados-tabla">
                        <thead>
                            <tr>
                                <th>Versión</th><th>Rep.</th><th>Estado</th>
                                <th>CPU (%)</th><th>RAM (MB)</th><th>Tiempo resp. prom. (ms)</th>
                                <th>Latencia P95 (ms)</th><th>Throughput (req/s)</th><th>Tamaño (MB)</th>
                                <th>OK / Fallidas</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in resultados)
                            {
                                <tr>
                                    <td>@r.VersionDotNet</td>
                                    <td>@r.NumeroEjecucion</td>
                                    <td>@EstadoEjecucionTexto(r.Estado)</td>
                                    <td>@Num(r.Cpu)</td>
                                    <td>@Num(r.RamMb)</td>
                                    <td>@Num(r.TiempoRespuestaMs)</td>
                                    <td>@Num(r.LatenciaP95Ms)</td>
                                    <td>@Num(r.ThroughputRps)</td>
                                    <td>@Num(r.TamanoMb)</td>
                                    <td>@r.SolicitudesExitosas / @r.SolicitudesFallidas</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </Panel>
            }

            @{ var niveles = Niveles; }
            @if (niveles.Count > 0)
            {
                <Panel Title="Niveles de estrés">
                    <table class="resultados-tabla">
                        <thead>
                            <tr>
                                <th>Versión</th><th>Rep.</th><th>Nivel</th><th>Usuarios</th>
                                <th>CPU (%)</th><th>RAM (MB)</th><th>Tiempo resp. prom. (ms)</th>
                                <th>Latencia P95 (ms)</th><th>Throughput (req/s)</th>
                                <th>OK / Fallidas</th><th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var nivel in niveles)
                            {
                                <tr>
                                    <td>@nivel.VersionDotNet</td>
                                    <td>@nivel.NumeroEjecucion</td>
                                    <td>@nivel.NumeroNivel</td>
                                    <td>@nivel.UsuariosObjetivo</td>
                                    <td>@Num(nivel.Cpu)</td>
                                    <td>@Num(nivel.RamMb)</td>
                                    <td>@Num(nivel.TiempoRespuestaMs)</td>
                                    <td>@Num(nivel.LatenciaP95Ms)</td>
                                    <td>@Num(nivel.ThroughputRps)</td>
                                    <td>@nivel.SolicitudesExitosas / @nivel.SolicitudesFallidas</td>
                                    <td>
                                        <span class="nivel-estado nivel-estado--@(nivel.Estado.ToLowerInvariant())">
                                            @EstadoNivelTexto(nivel.Estado)
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @{ var saturado = niveles.FirstOrDefault(n => n.Estado == "Saturado"); }
                    @if (saturado is not null)
                    {
                        <p class="ejecucion-saturacion">
                            ⚠ Saturación detectada en @saturado.UsuariosObjetivo usuarios (@saturado.VersionDotNet, repetición @saturado.NumeroEjecucion).
                        </p>
                    }
                </Panel>
            }
        </div>

        <div class="ejecucion-grid__bitacora">
            <LogConsole Title="Bitácora de ejecución" Lines="Logs"
                        EmptyText="@(_reconstruido is not null ? "La serie temporal y la bitácora solo están disponibles durante la ejecución activa." : "La bitácora mostrará el proceso al iniciar la evaluación.")" />
        </div>
    </div>
}

@code {
    [Parameter]
    public int ConfiguracionId { get; set; }

    private ConfiguracionEjecutableInfo? _info;
    private EvaluationExecutionSessionSnapshot? _snapshot;
    private EstadoEjecucionReconstruido? _reconstruido;
    private string? _mensaje;
    private OperationMessageKind _mensajeTipo;

    private PeriodicTimer? _timer;
    private CancellationTokenSource? _pollCts;

    private string? EstadoConfig =>
        _snapshot?.EstadoPersistidoConfiguracion ?? _reconstruido?.Info.Estado ?? _info?.Estado;

    private IReadOnlyList<EjecucionResumen> Resultados =>
        _snapshot?.Resultados ?? _reconstruido?.Ejecuciones ?? [];

    private IReadOnlyList<NivelEstresResumen> Niveles =>
        _snapshot?.Niveles ?? _reconstruido?.Niveles ?? [];

    private IReadOnlyList<string> Logs => _snapshot?.Logs ?? [];

    private bool PuedeIniciar => _info is { PuedeEjecutar: true } && _snapshot is null;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _info = await Servicio.ObtenerInfoAsync(ConfiguracionId);
            if (_info is null)
            {
                MostrarMensaje(OperationMessageKind.Error, "La configuración indicada no existe.");
                return;
            }

            _snapshot = Manager.GetSnapshot(ConfiguracionId);

            if (_snapshot is null && EsEstadoFinal(_info.Estado))
            {
                _reconstruido = await StatusQuery.ObtenerEstadoAsync(ConfiguracionId);
            }
            else if (_snapshot is null && !_info.PuedeEjecutar)
            {
                MostrarMensaje(OperationMessageKind.Info, _info.MotivoNoEjecutable ?? "La configuración no puede ejecutarse.");
            }

            if (_snapshot is { Activa: true })
            {
                IniciarPolling();
            }
            else
            {
                MostrarMensajeFinal();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No fue posible cargar la información de ejecución.");
            MostrarMensaje(OperationMessageKind.Error, "No fue posible cargar la información de la evaluación.");
        }
    }

    private async Task IniciarAsync()
    {
        var resultado = await Manager.StartAsync(ConfiguracionId);
        if (!resultado.Iniciada)
        {
            MostrarMensaje(OperationMessageKind.Info, resultado.Mensaje);
            _snapshot = Manager.GetSnapshot(ConfiguracionId);
            if (_snapshot is { Activa: true }) IniciarPolling();
            return;
        }

        _mensaje = null;
        _reconstruido = null;
        _snapshot = Manager.GetSnapshot(ConfiguracionId);
        IniciarPolling();
    }

    private void DetenerAsync()
    {
        Manager.RequestCancellation(ConfiguracionId);
        _snapshot = Manager.GetSnapshot(ConfiguracionId);
    }

    private void IniciarPolling()
    {
        _timer?.Dispose();
        _pollCts?.Cancel();
        _pollCts = new CancellationTokenSource();
        _timer = new PeriodicTimer(TimeSpan.FromMilliseconds(1000));
        _ = PollAsync(_timer, _pollCts.Token);
    }

    private async Task PollAsync(PeriodicTimer timer, CancellationToken token)
    {
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                _snapshot = Manager.GetSnapshot(ConfiguracionId);
                await InvokeAsync(StateHasChanged);
                if (_snapshot is null || !_snapshot.Activa)
                {
                    MostrarMensajeFinal();
                    await InvokeAsync(StateHasChanged);
                    break;
                }
            }
        }
        catch (OperationCanceledException)
        {
            // La página se cerró o se inició otro polling; no afecta a la evaluación.
        }
    }

    private void MostrarMensajeFinal()
    {
        if (_snapshot is not { } s || s.Activa)
        {
            return;
        }

        var (tipo, texto) = s.EstadoSesion switch
        {
            EstadoSesion.Finalizada => (OperationMessageKind.Success, s.MensajeActual ?? "La evaluación finalizó correctamente."),
            EstadoSesion.Cancelada => (OperationMessageKind.Info, s.MensajeActual ?? "Evaluación cancelada."),
            _ => (OperationMessageKind.Error, s.MensajeActual ?? "La evaluación no se completó.")
        };
        MostrarMensaje(tipo, texto);
    }

    private void MostrarMensaje(OperationMessageKind tipo, string mensaje)
    {
        _mensajeTipo = tipo;
        _mensaje = mensaje;
    }

    private static bool EsEstadoFinal(string? estado) =>
        estado is "Finalizada" or "Fallida" or "Cancelada";

    public void Dispose()
    {
        // Solo se detiene el temporizador de visualización; NUNCA la evaluación (vive en el manager).
        _pollCts?.Cancel();
        _pollCts?.Dispose();
        _timer?.Dispose();
    }

    private static IReadOnlyList<KeyValuePair<string, string>> Cabecera(ConfiguracionEjecutableInfo info) =>
    [
        new("Evaluación", info.Nombre),
        new("Proyecto", info.Proyecto),
        new("Tipo de prueba", info.TipoPrueba),
        new("Endpoint", $"{info.RutaObjetivo} (GET)"),
        new("Ejecuciones", info.NumeroEjecuciones.ToString(CultureInfo.InvariantCulture)),
        new("Versiones", ".NET 8 / .NET 10"),
        new("Métricas", string.Join(", ", info.Metricas))
    ];

    private static string Num(decimal? valor) =>
        valor is { } v ? v.ToString("0.##", CultureInfo.InvariantCulture) : "—";

    private static string EstadoTexto(string? estado) => estado switch
    {
        "Configurada" => "Configurada",
        "EnEjecucion" => "En ejecución",
        "Finalizada" => "Finalizada",
        "Fallida" => "Fallida",
        "Cancelada" => "Cancelada",
        _ => estado ?? "—"
    };

    private static string EstadoEjecucionTexto(string estado) => estado switch
    {
        "Completada" => "Completada",
        "CompletadaConSaturacion" => "Completada con saturación",
        "Fallida" => "Fallida",
        "Cancelada" => "Cancelada",
        _ => estado
    };

    private static string EstadoNivelTexto(string estado) => estado switch
    {
        "Completado" => "Completado",
        "Saturado" => "Saturado",
        "Fallido" => "Fallido",
        "Cancelado" => "Cancelado",
        _ => estado
    };

    private static string FaseTexto(FaseEjecucion? fase) => fase switch
    {
        FaseEjecucion.Preparacion => "Preparación",
        FaseEjecucion.Readiness => "Readiness",
        FaseEjecucion.WarmUp => "Warm-up",
        FaseEjecucion.RampUp => "Ramp-up",
        FaseEjecucion.Medicion => "Medición",
        FaseEjecucion.NivelEstres => "Nivel de estrés",
        FaseEjecucion.Concurrencia => "Concurrencia",
        FaseEjecucion.Finalizado => "Finalizado",
        _ => ""
    };
}
